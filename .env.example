telegram_bot_token=

USER_DB=
PASSWORD_DB=
POSTGRES_DB=

admin_id=

api_id=
api_hash=

# Логирование: DEBUG / INFO / WARNING / ERROR (по умолчанию INFO)
LOG_LEVEL=INFO

# Часовой пояс контейнеров и приложения (по умолчанию Europe/Moscow)
# TZ=Europe/Moscow

# UID/GID, под которым работает контейнер бота. По умолчанию 1000: файлы в
# ./state, ./jumis/logs и ./jumis/backups остаются твоими.
# PUID=1000
# PGID=1000

# Необязательно: путь к файлу сессии Telethon.
# По умолчанию — <репозиторий>/state/session_jumis.session (локально и в Docker
# это один и тот же файл: каталог state монтируется в контейнер).
# SESSION_PATH=/state/session_jumis.session
